# 必填：生成唯一随机 API Key，例如：openssl rand -hex 24
# 留空时服务/Compose 会拒绝启动，避免误用公开默认密码。
CP2A_API_KEY=

# Docker 主机侧默认仅绑定 loopback；需要局域网/公网访问时再显式改为 0.0.0.0。
CP2A_BIND_ADDR=127.0.0.1

# 可选覆盖（裸机默认 127.0.0.1:7867；Docker compose 会覆盖为容器内 :7867）
# CP2A_LISTEN=127.0.0.1:7867
# CP2A_AUTH_DIR=./auths
# CP2A_STATE_FILE=./data/state.json
# CP2A_DEFAULT_MODEL=auto
# CP2A_UPSTREAM_TIMEOUT_SECONDS=120
# CP2A_QUOTA_ENABLED=true
# CP2A_QUOTA_POLL_MINUTES=10
# CP2A_QUOTA_THRESHOLD=50
# CP2A_QUOTA_METHOD=register
# CP2A_QUOTA_COOLDOWN_HOURS=6
# CP2A_QUOTA_REGISTER_ON_START=true
# CP2A_QUOTA_AUTO_RENEW=true
# CP2A_QUOTA_RENEW_THRESHOLD_HOURS=6
